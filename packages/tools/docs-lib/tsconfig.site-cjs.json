{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist/site-cjs",
    "sourceMap": false,
    "tsBuildInfoFile": ".tsbuildinfo.site-cjs"
  },
  "include": [
    "src/discovery.ts",
    "src/types.ts",
    "src/visibility.ts",
    "src/loader.ts",
    "src/_internal/remark.ts",
    "src/_internal/site.ts"
  ]
}
