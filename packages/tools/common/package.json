      "import": "./dist/workflows/ensure-user-license/index.js",
      "types": "./dist/workflows/ensure-user-license/index.d.ts"
    },
    "./_internal/checks": {
      "import": "./dist/checks/index.js",
      "types": "./dist/checks/index.d.ts"
    },
    "./_internal/config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./_internal/templates": {
      "import": "./dist/templates/index.js",
      "types": "./dist/templates/index.d.ts"
    },
    "./_internal/templates/git": {
      "import": "./dist/templates/git/index.js",
      "types": "./dist/templates/git/index.d.ts"
    },
    "./_internal/templates/universal": {
      "import": "./dist/templates/universal.js",
      "types": "./dist/templates/universal.d.ts"
    },
    "./_internal/telemetry": {
      "import": "./dist/telemetry/index.js",
      "types": "./dist/telemetry/index.d.ts"
    },
    "./_internal/utils/retry": {
      "import": "./dist/utils/retry/index.js",
      "types": "./dist/utils/retry/index.d.ts"
    },
    "./_internal/workflows": {
      "import": "./dist/workflows/index.js",
      "types": "./dist/workflows/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/__tests__/**",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.site-cjs.json && node scripts/write-site-cjs-package-json.mjs",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist .tsbuildinfo",
    "test": "vitest --run"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/rayfin.git",
    "directory": "packages/tools/common"
  },
  "dependencies": {
    "tar": "~7.5.15",
    "yaml": "^2.8.2",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "rimraf": "~6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "@vitest/coverage-v8": "~3.2.4"
  },
  "license": "MIT"
}
