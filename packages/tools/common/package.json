{
  "name": "@microsoft/rayfin-tools-common",
  "version": "1.36.2",
  "description": "Shared utilities for Rayfin tools packages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./_internal": {
      "import": "./dist/internal.js",
      "types": "./dist/internal.d.ts"
    },
    "./_internal/feature-flags": {
      "types": "./dist/feature-flags.d.ts",
