      "import": "./dist/services/runtime-config/index.js",
      "types": "./dist/services/runtime-config/index.d.ts"
    },
    "./_internal/services/runtime-settings": {
      "import": "./dist/services/runtime-settings/index.js",
      "types": "./dist/services/runtime-settings/index.d.ts"
    },
    "./_internal/services/static-hosting": {
      "import": "./dist/services/static-hosting/index.js",
      "types": "./dist/services/static-hosting/index.d.ts"
    },
    "./_internal/services/storage": {
      "import": "./dist/services/storage/index.js",
