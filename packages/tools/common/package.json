      "import": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./_internal/env-config": {
      "import": "./dist/env-config/index.js",
      "types": "./dist/env-config/index.d.ts"
    },
    "./_internal/external/fabric": {
      "import": "./dist/external/fabric/index.js",
      "types": "./dist/external/fabric/index.d.ts"
    },
    "./_internal/services/auth": {
      "import": "./dist/services/auth/index.js",
      "types": "./dist/services/auth/index.d.ts"
    },
    "./_internal/services/connectors": {
      "import": "./dist/services/connectors/index.js",
      "types": "./dist/services/connectors/index.d.ts"
    },
    "./_internal/services/data": {
      "import": "./dist/services/data/index.js",
      "types": "./dist/services/data/index.d.ts"
    },
    "./_internal/services/auth-sdk": {
      "import": "./dist/services/auth-sdk/index.js",
      "types": "./dist/services/auth-sdk/index.d.ts"
    },
    "./_internal/services/package-inventory": {
      "import": "./dist/services/package-inventory/index.js",
      "types": "./dist/services/package-inventory/index.d.ts"
    },
    "./_internal/services/deployment-registry": {
      "import": "./dist/services/deployment-registry/index.js",
      "types": "./dist/services/deployment-registry/index.d.ts"
    },
    "./_internal/services/dev-redirect": {
      "import": "./dist/services/dev-redirect/index.js",
      "types": "./dist/services/dev-redirect/index.d.ts"
    },
    "./_internal/services/framework-env": {
      "import": "./dist/services/framework-env/index.js",
      "types": "./dist/services/framework-env/index.d.ts"
    },
    "./_internal/services/functions": {
      "import": "./dist/services/functions/index.js",
      "types": "./dist/services/functions/index.d.ts"
